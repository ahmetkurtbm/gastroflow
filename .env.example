# cp .env.example .env.local
# Değerler: Supabase Dashboard → Project Settings → API Keys

# Tarayıcıya gönderilir; eriştiği her satır RLS'ten geçer.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Yalnızca sunucuda. RLS'i atlar; asla NEXT_PUBLIC_ öneki almaz. Sızarsa hemen yenileyin.
SUPABASE_SERVICE_ROLE_KEY=""

# Bildirim e-postaları için (şu an gönderim mock, boş kalabilir).
RESEND_API_KEY=""
