# cp .env.example .env.local

# Yerel Postgres (docker compose up -d db). Boş bırakılırsa uygulama demo modunda,
# süreç içi PGlite ile açılır.
DATABASE_URL="postgres://postgres:postgres@localhost:5433/gastroflow"

# Oturum token'larını imzalar; en az 32 karakter. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
